<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>
            <Bug pattern="EI_EXPOSE_REP2"/>
        </Or>
    </Match>
    <!-- External callers populate these fields through generic Builder.with callbacks. -->
    <Match>
        <Class name="com.adobe.abp.regola.results.RuleResult$RuleResultBuilder"/>
        <Field name="~(message|cause)"/>
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
    </Match>
</FindBugsFilter>
